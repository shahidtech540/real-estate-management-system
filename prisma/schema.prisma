// Phase 3 additive records. Runtime services currently use SQLite; this is the
// equivalent PostgreSQL deployment design, not an active Prisma repository.
model OwnerStatement {
  id                 String   @id @default(cuid())
  organizationId     String   @map("organization_id")
  ownerId            String   @map("owner_id")
  propertyId         String?  @map("property_id")
  periodMonth        String   @map("period_month")
  grossRentMinor     BigInt   @default(0) @map("gross_rent_minor")
  expensesMinor      BigInt   @default(0) @map("expenses_minor")
  managementFeePct   Float    @default(5) @map("management_fee_pct")
  managementFeeMinor BigInt   @default(0) @map("management_fee_minor")
  netPayoutMinor     BigInt   @default(0) @map("net_payout_minor")
  currency           String   @default("PKR")
  status             String   @default("issued")
  lineItemsJson      String   @default("[]") @map("line_items_json")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdBy          String?  @map("created_by")
  @@unique([organizationId, ownerId, periodMonth])
  @@map("owner_statements")
}
model LeaseEvent {
