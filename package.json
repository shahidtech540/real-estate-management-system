{
  "name": "rems-agentic-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic Real Estate Management System (REMS) - Multi-tenant Property, CRM, Lease, Accounting & AI Agent Platform",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:seed": "tsx src/server/db/seed-cli.ts",
    "billing:cycle": "tsx src/server/modules/billing/cycle-cli.ts",
    "maintenance:cycle": "tsx src/server/modules/maintenance/cycle-cli.ts",
    "maintenance:worker": "tsx src/server/modules/maintenance/cycle-cli.ts --watch",
    "accounting:sync": "tsx src/server/modules/accounting/cycle-cli.ts --sync",
    "reports:cycle": "tsx src/server/modules/accounting/cycle-cli.ts",
    "reports:worker": "tsx src/server/modules/accounting/cycle-cli.ts --watch",
    "agents:cycle": "tsx src/server/modules/orchestration/cycle-cli.ts",
    "agents:worker": "tsx src/server/modules/orchestration/cycle-cli.ts --watch",
    "validate:design": "node scripts/validate-design.cjs",
    "test:agents": "vitest run tests/domain-agents.eval.test.ts tests/phase7.test.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@prisma/prisma-schema-wasm": "^6.19.0-26.2ba551f319ab1df4bc874a89965d8b3641056773",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  }
}
