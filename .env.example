# ==============================================================================
# Agentic Real Estate Management System (REMS) - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Fahad Real Estate"

# ------------------------------------------------------------------------------
# Database Configuration
# By default in local dev/CI without Docker, the app uses the embedded SQLite
# database at ./data/rems.sqlite. In Docker/Production, set DATABASE_URL to
# PostgreSQL design is NOT an implemented runtime switch. SQLite is active.
# ------------------------------------------------------------------------------
DB_ENGINE=sqlite
SQLITE_DB_PATH=./data/rems.sqlite
DATABASE_URL=postgresql://rems_user:rems_password@localhost:5432/rems_db?schema=public

# ------------------------------------------------------------------------------
# Authentication, JWT & 2FA Security
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=rems-dev-jwt-access-secret-change-in-production-2026
JWT_REFRESH_SECRET=rems-dev-jwt-refresh-secret-change-in-production-2026
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
TOTP_ISSUER=Fahad-Real-Estate

# ------------------------------------------------------------------------------
# Cache & Background Queue (Redis + BullMQ)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
QUEUE_ADAPTER=memory

# ------------------------------------------------------------------------------
# Object Storage (S3 / MinIO)
# ------------------------------------------------------------------------------
STORAGE_ADAPTER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=rems-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ------------------------------------------------------------------------------
# Payment Gateways (Adapters: mock | live)
# Supports: Bank Transfer, Cash, JazzCash, Easypaisa, Stripe
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER_MODE=mock
JAZZCASH_MERCHANT_ID=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Notification Providers (Email, SMS, WhatsApp)
# ------------------------------------------------------------------------------
# Only mock delivery is implemented. live fails closed; credentials alone do not enable sends.
# Run `npm run maintenance:worker` with the SAME SQLITE_DB_PATH as the app.
NOTIFICATION_PROVIDER_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_BUSINESS_TOKEN=

# ------------------------------------------------------------------------------
# Agentic AI Layer (Anthropic Claude API)
# Leave ANTHROPIC_API_KEY empty in local dev/CI to use the deterministic
# policy-compliant agent orchestrator engine.
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AI_GLOBAL_KILL_SWITCH=false
AI_DEFAULT_AUTONOMY=act_with_approval
AI_MAX_STEPS_PER_RUN=8
AI_RUN_COST_BUDGET_MINOR=50000

# Actual deployed website origin for absolute QR/feed URLs; leave blank until known.
PUBLIC_SITE_URL=

# Phase 8 actual deployment controls. NODE_ENV=production alone is a Next.js build mode.
# demo permits documented demo accounts; production disables seeding/demo UI and
# requires distinct 32+ character secrets and an explicit persistent database path.
REMS_DEPLOYMENT=demo
TRUSTED_ORIGINS=
# production defaults to self; demo permits embedding for Arena preview.
FRAME_ANCESTORS=
PUBLIC_ORGANIZATION_ID=
# Only for first EMPTY production database provisioning; unset after use.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AGENT_PROVIDER_MODE=local
